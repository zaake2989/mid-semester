<main class="container py-5">
    <h1 class="text-center mb-4">My Photo Gallery</h1>

    <section class="row g-4">
        <div class="col-sm-6 col-lg-4">
            <figure class="gallery-card">
                <img src="images/photo1.jpg" alt="My studies">
                <figcaption>My Studies</figcaption>
            </figure>
        </div>

        <div class="col-sm-6 col-lg-4">
            <figure class="gallery-card">
                <img src="images/photo2.jpg" alt="My hobbies">
                <figcaption>My Hobbies</figcaption>
            </figure>
        </div>

        <div class="col-sm-6 col-lg-4">
            <figure class="gallery-card">
                <img src="images/photo3.jpg" alt="My projects">
                <figcaption>My Projects</figcaption>
            </figure>
        </div>
    </section>

    <section class="mt-5">
        <h2>Self-Introduction Video</h2>
        <p>Introduce yourself in a short video.</p>
        <video controls class="w-100 rounded video-frame">
            <source src="my-introduction.mp4" type="video/mp4">
            Your browser does not support video.
        </video>
    </section>
